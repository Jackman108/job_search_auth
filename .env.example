# Preferred: shared Postgres (postgres_container) on :5432 / job_search — same as backend.
DATABASE_URL="postgresql://postgres:password@localhost:5432/job_search?schema=public"
# Optional isolated auth DB (auth_postgres on :5433):
# DATABASE_URL="postgresql://postgres:123456@localhost:5433/db_test?schema=public"
JWT_EXP=5m
# ≥32 chars; production refuses known defaults (change_me / very_secret / your-secret-key)
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars

# CORS + listen port (client defaults AUTH_URL → http://localhost:8001/api)
ALLOWED_ORIGIN=http://localhost:3000
APP_PORT=8001

# Redis (express-session store). Matches docker compose redis on :6379
REDIS_URI=redis://localhost:6379

# express-session
SESSION_SECRET=change_me_session_secret
SESSION_NAME=session
SESSION_DOMAIN=localhost
SESSION_MAX_AGE=30d
SESSION_HTTP_ONLY=true
SESSION_SECURE=false
SESSION_FOLDER=session:

# Periodic delete of expired refresh tokens (A5). Default 1h if unset.
# TOKEN_CLEANUP_INTERVAL_MS=3600000


# Может принимать значения development | production
# NODE_ENV=development
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
YANDEX_APP_ID="YOUR_YANDEX_APP_ID"
YANDEX_APP_SECRET="YOUR_YANDEX_APP_SECRET"
